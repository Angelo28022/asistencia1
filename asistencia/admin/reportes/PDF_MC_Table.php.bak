<?php
require('../fpdf181/fpdf.php');

class PDF_MC_Table extends FPDF
{
var $widths;
var $aligns;

function Header()
{
    // Title
    $this->SetFont('Arial','B',15);
    $this->Cell(80);
    $this->Cell(30,10,'Reporte de Articulos',0,0,'C');
    $this->Ln(5);

    // Logo
    $logo_path = 'logo.png';
    if (file_exists($logo_path)) {
        // A4 page width is 210mm. Right margin 2cm=20mm. Logo width 5cm=50mm.
        // X position = 210 - 20 - 50 = 140
        $this->Image($logo_path, 140, 15, 50);
    } else {
        $this->SetXY(140, 15);
        $this->SetFont('Helvetica','B',12);
        $this->SetTextColor(0,51,102); // #003366
        $this->Cell(60,10, 'LOGO INSTITUCIONAL', 0, 0, 'C');
        $this->SetTextColor(0,0,0); // Reset color
    }

    // Header bottom line
    $this->SetY(45); // 1.5cm margin + 3cm logo height approx
    $this->SetDrawColor(128,128,128); // Grey
    $this->SetLineWidth(0.2); // 0.5pt
    $this->Line($this->lMargin, 45, $this->w - $this->rMargin, 45);
    $this->Ln(5);
}

function SetWidths($w)
{
    //Set the array of column widths
    $this->widths=$w;
}

function SetAligns($a)
{
    //Set the array of column alignments
    $this->aligns=$a;
}

function Row($data)
{
    //Calculate the height of the row
    $nb=0;
    for($i=0;$i<count($data);$i++)
        $nb=max($nb,$this->NbLines($this->widths[$i],$data[$i]));
    $h=5*$nb;
    //Issue a page break first if needed
    $this->CheckPageBreak($h);
    //Draw the cells of the row
    for($i=0;$i<count($data);$i++)
    {
        $w=$this->widths[$i];
        $a=isset($this->aligns[$i]) ? $this->aligns[$i] : 'L';
        //Save the current position
        $x=$this->GetX();
        $y=$this->GetY();
        //Draw the border
        $this->Rect($x,$y,$w,$h);
        //Print the text
        $this->MultiCell($w,5,$data[$i],0,$a);
        //Put the position to the right of the cell
        $this->SetXY($x+$w,$y);
    }
    //Go to the next line
    $this->Ln($h);
}

function CheckPageBreak($h)
{
    //If the height h would cause an overflow, add a new page immediately
    if($this->GetY()+$h>$this->PageBreakTrigger)
        $this->AddPage($this->CurOrientation);
}

function NbLines($w,$txt)
{
    //Computes the number of lines a MultiCell of width w will take
    $cw=&$this->CurrentFont['cw'];
    if($w==0)
        $w=$this->w-$this->rMargin-$this->x;
    $wmax=($w-2*$this->cMargin)*1000/$this->FontSize;
    $s=str_replace("\r",'',$txt);
    $nb=strlen($s);
    if($nb>0 and $s[$nb-1]=="\n")
        $nb--;
    $sep=-1;
    $i=0;
    $j=0;
    $l=0;
    $nl=1;
    while($i<$nb)
    {
        $c=$s[$i];
        if($c=="\n")
        {
            $i++;
            $sep=-1;
            $j=$i;
            $l=0;
            $nl++;
            continue;
        }
        if($c==' ')
            $sep=$i;
        $l+=$cw[$c];
        if($l>$wmax)
        {
            if($sep==-1)
            {
                if($i==$j)
                    $i++;
            }
            else
                $i=$sep+1;
            $sep=-1;
            $j=$i;
            $l=0;
            $nl++;
        }
        else
            $i++;
    }
    return $nl;
}
}
?>